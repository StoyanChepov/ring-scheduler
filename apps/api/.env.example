# Copy to .env and fill in. .env is git-ignored.

# Matches the Postgres service in the root docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ring_scheduler"

PORT=3000

# Secret used to sign login tokens. Must be at least 32 characters; the API
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login token stays valid, in seconds (default 3600 = 1 hour)
# JWT_EXPIRES_IN_SECONDS=3600

# --- Push delivery (Firebase Cloud Messaging) ---------------------------------
# Optional. Without these, MOCK devices still work, but ANDROID devices will
# report "Push delivery is not configured on the server".
# Create a service account in Firebase console > Project settings > Service
# accounts > Generate new private key, then set ONE of:
#   FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
#   FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# A set-but-broken value stops the API at startup rather than silently falling
# back to mock mode. Never commit the key file.
#
# Check that the key works (no device needed, nothing is delivered):
#   pnpm push:test
# Then ring a real device with a token from it:
#   pnpm push:test <device-token>
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
