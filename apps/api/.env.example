# Copy to .env and fill in. .env is git-ignored.

# Matches the Postgres service in the root docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ring_scheduler"

PORT=3000

# Secret used to sign login tokens. Must be at least 32 characters; the API
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login token stays valid, in seconds (default 3600 = 1 hour)
# JWT_EXPIRES_IN_SECONDS=3600
