// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  devices      Device[]
  ringtones    Ringtone[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Device {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  name              String
  platform          String        @default("ANDROID")
  fcmToken          String?
  // SHA-256 of the device key the phone authenticates with; the key itself is
  // only ever shown once, when it is issued.
  keyHash           String?       @unique
  defaultRingtoneId String?
  lastSeenAt         DateTime?
  commands          RingCommand[]
  schedules          RingSchedule[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model RingCommand {
  id              String   @id @default(uuid())
  userId          String
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id])
  type            String   // RING_START or RING_STOP
  status          String   // CREATED, SENT, FAILED
  durationSeconds Int?
  ringtoneId      String?
  createdAt       DateTime @default(now())
}

model RingSchedule {
  id              String    @id @default(uuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id])
  label           String?
  // ONE_TIME rings once at startAt. WEEKLY rings at timeOfDay ("HH:mm") on
  // daysOfWeek (1 = Monday ... 7 = Sunday), in the phone's local time zone.
  kind            String
  startAt         DateTime?
  timeOfDay       String?
  daysOfWeek      Int[]
  durationSeconds Int
  ringtoneId      String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deviceId])
}

model Ringtone {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
}