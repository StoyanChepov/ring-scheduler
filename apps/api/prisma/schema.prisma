// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  devices      Device[]
  ringtones    Ringtone[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Device {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  name              String
  platform          String         @default("ANDROID")
  fcmToken          String?
  // SHA-256 of the device key the phone authenticates with; the key itself is
  // only ever shown once, when it is issued.
  keyHash           String?        @unique
  defaultRingtoneId String?
  lastSeenAt        DateTime?
  commands          RingCommand[]
  schedules         RingSchedule[]
  events            AlarmEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model RingCommand {
  id              String   @id @default(uuid())
  userId          String
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id])
  type            String // RING_START or RING_STOP
  status          String // CREATED, SENT, FAILED
  durationSeconds Int?
  ringtoneId      String?
  createdAt       DateTime @default(now())
}

model RingSchedule {
  id              String    @id @default(uuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id])
  label           String?
  // ONE_TIME rings once at startAt. WEEKLY rings at timeOfDay ("HH:mm") on
  // daysOfWeek (1 = Monday ... 7 = Sunday), in the phone's local time zone.
  kind            String
  startAt         DateTime?
  timeOfDay       String?
  daysOfWeek      Int[]
  durationSeconds Int
  // No ringtone means the phone's default alarm sound.
  ringtoneId      String?
  ringtone        Ringtone? @relation(fields: [ringtoneId], references: [id], onDelete: SetNull)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deviceId])
}

// An uploaded alarm sound. Stored in the database (capped at 1 MB) so the demo
// needs no separate file storage.
model Ringtone {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  schedules RingSchedule[]
  createdAt DateTime       @default(now())
}

// What actually happened on the phone, reported by the phone itself.
model AlarmEvent {
  // Chosen by the phone, so a retried upload can't create duplicates.
  id         String   @id
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // STARTED, FINISHED (duration ran out), STOPPED (with who in detail), FAILED
  type       String
  // SCHEDULE or COMMAND (a "Ring now" from the dashboard)
  source     String
  scheduleId String?
  commandId  String?
  detail     String?
  // The phone's clock: events can be uploaded long after they happened.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([deviceId, occurredAt])
}
